# 백엔드 API 베이스 URL. 서버 컴포넌트와 클라이언트 재조회가 모두 사용하므로
# 브라우저에서도 접근 가능한 주소여야 한다. 없으면 빌드/런타임에서 throw.
NEXT_PUBLIC_API_URL=https://api.example.com

# 리뷰/제품 이미지 S3 키 앞에 붙일 CDN 오리진 (끝 슬래시 없이).
# 비어 있으면 이미지가 상대경로로 해석돼 전부 404 난다.
# Next.js는 NEXT_PUBLIC_* 를 빌드 시점에 인라인하므로 배포 환경에도 반드시 설정할 것.
NEXT_PUBLIC_CDN_PREFIX=https://cdn.example.com

# canonical / sitemap / RSS / OG 에 쓰이는 사이트 절대 URL (끝 슬래시 없이).
# 미설정 시 https://web.dasii.kr 로 폴백한다.
NEXT_PUBLIC_SITE_URL=https://web.dasii.kr
